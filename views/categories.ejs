<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kategori - Inventory System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
      <span class="navbar-brand">Inventory System</span>
      <div>
        <a href="/products" class="btn btn-outline-light btn-sm me-2">Produk</a>
        <a href="/categories" class="btn btn-light btn-sm me-2">Kategori</a>
        <a href="/users" class="btn btn-outline-light btn-sm">User</a>
      </div>
    </div>
  </nav>
  
  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Daftar Kategori</h2>
      <a href="/categories/add" class="btn btn-success">Tambah Kategori</a>
    </div>
    
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Nama Kategori</th>
          <th>Deskripsi</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(item => { %>
        <tr>
          <td><%= item.id %></td>
          <td><%= item.name %></td>
          <td><%= item.description || '-' %></td>
          <td>
            <a href="/categories/edit/<%= item.id %>" class="btn btn-warning btn-sm">Edit</a>
            <a href="/categories/delete/<%= item.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Yakin hapus kategori ini?')">Hapus</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
